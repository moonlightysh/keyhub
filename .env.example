# ====== 应用配置 ======
# Flask 运行端口
FLASK_PORT=5000
# Flask 调试模式（生产环境请改为 False）
FLASK_DEBUG=True
# Flask 秘钥（用于 session，部署时请改为随机长字符串）
FLASK_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ====== 阿里云 OSS 备份配置 ======
# 用于每天定时备份 data/users.json 到 OSS（仅文件有变化时才上传）
# 建议创建 RAM 子账号，仅授予目标 Bucket 的读写权限
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS Endpoint，如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# Bucket 名称
OSS_BUCKET=
# 存储路径前缀（默认 keyhub-backup/）
OSS_PREFIX=keyhub-backup/

# crontab 每天凌晨 3 点自动备份：
# 0 3 * * * cd /opt/keyhub && .venv/bin/python backup_oss.py >> logs/backup.log 2>&1
