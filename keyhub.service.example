[Unit]
Description=KeyHub GPG encrypted email webapp
After=network.target

[Service]
# ===== 根据实际情况修改 =====
Type=simple
User=root                               # 或者专门的用户，例如 keyhub
WorkingDirectory=/opt/keyhub            # 代码存放的目录
Environment=PATH=/opt/keyhub/.venv/bin:/usr/bin:/bin
# ===== 一般不用改 =====
ExecStart=/opt/keyhub/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 --timeout 60 app:app
Restart=always
RestartSec=5
# 环境变量也可以直接写在这里（推荐），比放 .env 更安全
# Environment=FLASK_SECRET_KEY=随机长字符串
# Environment=SMTP_HOST=smtp.qq.com
# Environment=SMTP_PORT=465
# Environment=SMTP_USE_SSL=True
# Environment=SMTP_USER=your_email@example.com
# Environment=SMTP_PASSWORD=你的授权码
# Environment=SMTP_FROM_NAME=KeyHub 加密邮件服务

[Install]
WantedBy=multi-user.target
